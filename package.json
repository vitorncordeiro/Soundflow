{
  "name": "pulse-player",
  "version": "1.0.0",
  "private": true,
  "description": "Pulse Player: player de musica web com Lista, Fila (FIFO) e Pilha (LIFO)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "pnpm --filter @pulse/shared build",
    "dev": "pnpm --filter @pulse/shared build && pnpm --parallel --filter @pulse/api --filter @pulse/web dev",
    "build": "pnpm --filter @pulse/shared build && pnpm -r --filter \"./apps/*\" build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @pulse/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @pulse/shared build && pnpm -r test",
    "test:e2e": "pnpm --filter @pulse/api test:e2e",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait db && pnpm db:migrate",
    "db:generate": "pnpm --filter @pulse/api db:generate",
    "db:migrate": "pnpm --filter @pulse/api db:migrate",
    "db:seed": "pnpm --filter @pulse/api db:seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma"
    ]
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.1"
  }
}
